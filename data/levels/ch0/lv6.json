        "dialogue": {
          "speaker": "指挥官",
          "text": "常规弹药你已经玩得很熟了。今天开放军械库最后一排——特种武器。"
        }
      },
      {
        "bg": "bridge",
        "left": "commander",
        "right": "peach:standing",
        "dialogue": {
          "speaker": "桃子",
          "text": "分裂弹撞击后炸成三颗小弹，对付摊开的补给堆场最合适。"
        }
      },
      {
        "bg": "bridge",
        "left": null,
        "right": "peach:thinking",
        "dialogue": {
          "speaker": "桃子",
          "text": "燃烧弹不靠爆炸——它灼烧弹簧，持续降低断裂阈值。再硬的桁架，烧一会儿就自己散了。"
        }
      },
      {
        "bg": "bridge",
        "left": "commander",
        "right": "peach:confident",
        "dialogue": {
          "speaker": "指挥官",
          "text": "还有引力弹：撞击点生成三秒引力阱，能把别的子弹轨道弯过来。北面的堆场、南面的装甲塔，各个击破。"
        }
      }
    ]
